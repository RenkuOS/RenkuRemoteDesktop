resource app_signature "application/x-vnd.RenkuOS-RemoteDesktop";

// A background app: the registrar asks it to quit late in a shutdown and
// does not let it cancel the shutdown. QuitRequested() returns false until
// the sessions have ended, which would otherwise abort every shutdown.
resource app_flags B_EXCLUSIVE_LAUNCH | B_BACKGROUND_APP;

resource app_version {
	major  = 0,
	middle = 1,
	minor  = 0,
	variety = B_APPV_DEVELOPMENT,
	internal = 0,
	short_info = "RenkuRemoteDesktop",
	long_info = "RDP server for RenkuOS and Haiku"
};
